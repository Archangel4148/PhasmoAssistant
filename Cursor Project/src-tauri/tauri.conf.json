{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phasmophobia Companion",
  "version": "0.1.0",
  "identifier": "com.sedmunds.phasmophobia-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phasmophobia Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "overlay",
        "title": "Phasmophobia Overlay",
        "width": 1920,
        "height": 1080,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
